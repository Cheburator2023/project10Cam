    <bpmn:sequenceFlow id="Flow_1hb5sjk" name="Разработка успешна, переход на этап пилотирования модели" sourceRef="Gateway_0f23s5v" targetRef="Activity_0czek2k">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${datamart_script_success_ds_flg== 'Разработка успешна, требуется пилотирование модели'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1e4w2cu" name="Разработка успешна" sourceRef="Gateway_0f23s5v" targetRef="Activity_0gyuf8p">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${datamart_script_success_ds_flg== 'Разработка успешна'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0hqo96b" sourceRef="Activity_0gyuf8p" targetRef="Event_1bgj31p" />
