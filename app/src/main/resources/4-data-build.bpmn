      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${datamart_script_success_de_flg== 'Разработка успешна, требуется пилотирование'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1x0mfyx" name="Разработка успешна, пилотирование не требуется" sourceRef="Gateway_05nu7qo" targetRef="datamart_built_ds">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${datamart_script_success_de_flg== 'Разработка успешна'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_134cicg" sourceRef="datamart_pilot_de" targetRef="Gateway_15pz9h9" />
    <bpmn:sequenceFlow id="Flow_1gi8psu" name="Пилотирование не успешно, требуются доработки" sourceRef="Gateway_15pz9h9" targetRef="data_build_script_attach_de">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${datamart_pilot_de_flg== 'Не успешно'}</bpmn:conditionExpression>
