          <camunda:script scriptFormat="JavaScript">var imagePimNexusAddr= execution.getVariable("imagePimNexusAddr");
var containerCfgPimNexusAddr= execution.getVariable("containerCfgPimNexusAddr");
var attr_list = JSON.stringify({
imagePimNexusAddr: imagePimNexusAddr,
containerCfgPimNexusAddr: containerCfgPimNexusAddr
})
execution.setVariable("attr_list", attr_list);</camunda:script>
