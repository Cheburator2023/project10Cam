          <camunda:outputParameter name="analytical_monitoring">${analytical_monitoring}</camunda:outputParameter>
          <camunda:outputParameter name="target_variable">${target_variable}</camunda:outputParameter>
          <camunda:outputParameter name="product_name">${product_name}</camunda:outputParameter>
          <camunda:outputParameter name="model_changes_info">${model_changes_info}</camunda:outputParameter>
          <camunda:outputParameter name="rfd">${rfd}</camunda:outputParameter>
          <camunda:outputParameter name="order_for_developing_or_buiseness_case">${order_for_developing_or_buiseness_case}</camunda:outputParameter>
          <camunda:outputParameter name="need_first_validation_flg">${need_first_validation_flg}</camunda:outputParameter>
          <camunda:outputParameter name="need_plan_validation_flg">${need_plan_validation_flg}</camunda:outputParameter>
          <camunda:outputParameter name="plan_date_integration">${plan_date_integration}</camunda:outputParameter>
          <camunda:outputParameter name="dev_model_status_flg">${dev_model_status_flg}</camunda:outputParameter>
          <camunda:outputParameter name="model_stage">Инициализация</camunda:outputParameter>
          <camunda:outputParameter name="model_status">В процессе разработки</camunda:outputParameter>
        </camunda:inputOutput>
