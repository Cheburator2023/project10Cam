    <bpmn:userTask id="filling_information" name="Заполнение заявки на разработку модели в СУМ" camunda:candidateGroups="ds_lead, ds">
      <bpmn:documentation>Заполнить основную информацию по модели</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="group_company" label="Компания группы" type="string" />
          <camunda:formField id="significance_validity" label="Уровень значимости Модели/РС " type="string" />
          <camunda:formField id="responsible_for_significance_validity" label="Кем определен уровень значимости Модели / РС" type="string" />
          <camunda:formField id="provides_piloting" label="Предусмотрено пилотирование" type="string" />
          <camunda:formField id="operational_monitoring" label="Оперативный мониторинг" type="string" />
          <camunda:formField id="analytical_monitoring" label="Аналитический мониторинг" type="string" />
          <camunda:formField id="target_variable" label="Целевая переменная" type="string" />
          <camunda:formField id="product_name" label="Продукт и область применения модели" type="string" />
          <camunda:formField id="model_changes_info" label="Краткая информация о решениях по изменению Модели" type="string" />
          <camunda:formField id="rfd" label="RFD" type="string" />
          <camunda:formField id="order_for_developing_or_buiseness_case" label="Заявка на разработку модели или описание гипотезы бизнес-кейса" type="string" />
          <camunda:formField id="need_first_validation_flg" label="Требуется первичная валидация" type="string" />
          <camunda:formField id="need_plan_validation_flg" label="Требуется полная валидация" type="string" />
          <camunda:formField id="plan_date_integration" label="Плановая дата внедрения" type="string" />
          <camunda:formField id="dev_model_status_flg" label="Модель давно разработана или уже работает в промышленном контуре? (при стандартном процессе разработке - выбрать &#34;Нет&#34;)" type="string" />
        </camunda:formData>
        <camunda:inputOutput>
          <camunda:inputParameter name="model_stage">Инициализация</camunda:inputParameter>
          <camunda:inputParameter name="model_status">В процессе разработки</camunda:inputParameter>
          <camunda:outputParameter name="group_company">${group_company}</camunda:outputParameter>
          <camunda:outputParameter name="significance_validity">${significance_validity}</camunda:outputParameter>
          <camunda:outputParameter name="responsible_for_significance_validity">${responsible_for_significance_validity}</camunda:outputParameter>
          <camunda:outputParameter name="provides_piloting">${provides_piloting}</camunda:outputParameter>
